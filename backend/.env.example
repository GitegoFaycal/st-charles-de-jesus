# Local development (copy to backend/.env). On Vercel, set these in Project > Settings > Environment Variables.
PORT=5000

# Long random string used to sign admin sessions. Required in production.
JWT_SECRET=change-this-to-a-long-random-secret

# First admin account. Only used when the content store has no users yet.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin1234

# Only needed when the frontend is served from a different origin than the API (not on Vercel).
# CLIENT_ORIGIN=http://localhost:5173

# Production storage (added automatically by Vercel when you connect Upstash Redis and Blob
# from the project's Storage tab). Leave unset locally to use backend/data/db.json and
# frontend/public/uploads instead.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# BLOB_READ_WRITE_TOKEN=
# DB_KEY=scj:db   # use e.g. scj:preview on Vercel Preview deployments

# Recommended on Vercel so Express handles request bodies itself.
# NODEJS_HELPERS=0
